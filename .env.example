# ReproFlow Environment Configuration Template

# Chrome Extension: GitHub OAuth App Client ID (Device Flow)
# Register an OAuth App at: https://github.com/settings/developers
# Ensure "Enable Device Flow" is checked in your OAuth App settings.
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# Local Runner Configuration (Optional)
# Port for the local Playwright verification runner (default: 8787)
REPROFLOW_PORT=8787

# Shared secret session token for runner HTTP authentication (optional; random token generated if unset)
REPROFLOW_TOKEN=
